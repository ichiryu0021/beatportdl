/* BPDownloader - dark theme (modern, flat) */

QMainWindow, QDialog, QWidget {
    background-color: #1e1f24;
    color: #e3e5ea;
}

QWidget:disabled { color: #6e7280; }

/* ---- Tabs ---- */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #33363f;
    background: #1e1f24;
}
QTabBar::tab {
    background: transparent;
    color: #9aa0ad;
    padding: 6px 14px;
    border: none;
    margin-right: 2px;
}
QTabBar::tab:selected {
    color: #7aa7ff;
    border-bottom: 2px solid #3b82f6;
}
QTabBar::tab:hover:!selected { color: #e3e5ea; }

/* ---- Buttons ---- */
QPushButton {
    background-color: #2b2e37;
    color: #e3e5ea;
    border: 1px solid #3d414c;
    padding: 4px 14px;
    border-radius: 5px;
}
QPushButton:hover   { background-color: #343844; border-color: #4a4f5c; }
QPushButton:pressed { background-color: #26282f; }
QPushButton:disabled { background:#26282f; color:#6e7280; border-color:#33363f; }

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: #26282f;
    color: #e3e5ea;
    border: 1px solid #3d414c;
    border-radius: 5px;
    padding: 3px 6px;
    selection-background-color: #2f4d80;
    selection-color: #ffffff;
}
QLineEdit:hover, QSpinBox:hover, QComboBox:hover,
QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #3b82f6;
}
QLineEdit:disabled, QComboBox:disabled {
    background-color: #23242a;
    color: #6e7280;
    border-color: #33363f;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #26282f;
    color: #e3e5ea;
    border: 1px solid #3d414c;
    border-radius: 5px;
    padding: 3px;
    selection-background-color: #2f4d80;
    selection-color: #ffffff;
    outline: none;
}
QComboBox QAbstractItemView::item {
    background-color: transparent;
    color: #e3e5ea;
    min-height: 22px;
    border-radius: 4px;
    padding: 2px 8px;
}
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #2f4d80;
    color: #ffffff;
}

/* ---- Lists / tables ---- */
QListWidget, QTableWidget, QTreeWidget {
    background-color: #23242a;
    color: #e3e5ea;
    border: 1px solid #33363f;
    border-radius: 6px;
    alternate-background-color: #26282f;
}
QListWidget::item, QTreeWidget::item { color: #e3e5ea; }
QListWidget::item { border-radius: 4px; }
QListWidget::item:hover { background-color: #2d3038; }
QListWidget::item:selected,
QTreeWidget::item:selected {
    background-color: #2f4d80;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #26282f;
    color: #9aa0ad;
    border: none;
    border-right: 1px solid #33363f;
    border-bottom: 1px solid #33363f;
    padding: 4px 8px;
    font-weight: 600;
}
QTableCornerButton::section {
    background-color: #26282f;
    border: none;
    border-bottom: 1px solid #33363f;
}

/* ---- Checkboxes / radios ---- */
QCheckBox, QRadioButton {
    background-color: transparent;
    color: #e3e5ea;
    spacing: 6px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #565b68;
    background-color: #26282f;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #3b82f6;
}
QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
    image: url(:/gui/check.png);
    image-position: center;
}
QRadioButton::indicator:checked {
    background-color: #3b82f6;
    border: 3px solid #1e1f24;
    outline: 1px solid #3b82f6;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #23242a;
    border-color: #3d414c;
}

/* ---- Progress ---- */
QProgressBar {
    background-color: #33363f;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #e3e5ea;
}
QProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 4px;
}

/* ---- Scroll bars ---- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #3d414c; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #4a4f5c; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #3d414c; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #4a4f5c; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---- Menus / tooltips ---- */
QMenu {
    background-color: #26282f;
    color: #e3e5ea;
    border: 1px solid #3d414c;
    border-radius: 6px;
    padding: 3px;
}
QMenu::item {
    background-color: transparent;
    border-radius: 4px;
    padding: 5px 24px 5px 14px;
}
QMenu::item:selected { background-color: #2f4d80; }
QMenu::separator { height: 1px; background: #33363f; margin: 4px 8px; }
QToolTip {
    background-color: #e3e5ea;
    color: #1e1f24;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QPlainTextEdit { font-family: Consolas, "Courier New", monospace; }
