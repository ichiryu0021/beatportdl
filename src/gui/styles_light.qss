/* BPDownloader - light theme (modern, flat) */

QMainWindow, QDialog, QWidget {
    background-color: #ffffff;
    color: #1f2329;
}

QWidget:disabled { color: #a8adb5; }

/* ---- Tabs ---- */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #e3e5e8;
    background: #ffffff;
}
QTabBar::tab {
    background: transparent;
    color: #5f6672;
    padding: 6px 14px;
    border: none;
    margin-right: 2px;
}
QTabBar::tab:selected {
    color: #2563eb;
    border-bottom: 2px solid #2563eb;
}
QTabBar::tab:hover:!selected { color: #1f2329; }

/* ---- Buttons ---- */
QPushButton {
    background-color: #ffffff;
    color: #1f2329;
    border: 1px solid #d4d7dc;
    padding: 4px 14px;
    border-radius: 5px;
}
QPushButton:hover   { background-color: #f3f5f9; border-color: #b9bec7; }
QPushButton:pressed { background-color: #e8ebf0; }
QPushButton:disabled { background:#f7f8fa; color:#a8adb5; border-color:#e6e8ec; }

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #1f2329;
    border: 1px solid #d4d7dc;
    border-radius: 5px;
    padding: 3px 6px;
    selection-background-color: #cfe0ff;
    selection-color: #1f2329;
}
QLineEdit:hover, QSpinBox:hover, QComboBox:hover,
QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #2563eb;
}
QLineEdit:disabled, QComboBox:disabled {
    background-color: #f5f6f8;
    color: #a8adb5;
    border-color: #e6e8ec;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2329;
    border: 1px solid #d4d7dc;
    border-radius: 5px;
    padding: 3px;
    selection-background-color: #e8f0fe;
    selection-color: #1f2329;
    outline: none;
}
QComboBox QAbstractItemView::item {
    background-color: transparent;
    color: #1f2329;
    min-height: 22px;
    border-radius: 4px;
    padding: 2px 8px;
}
QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #e8f0fe;
    color: #1f2329;
}

/* ---- Lists / tables ---- */
QListWidget, QTableWidget, QTreeWidget {
    background-color: #ffffff;
    color: #1f2329;
    border: 1px solid #e3e5e8;
    border-radius: 6px;
    alternate-background-color: #f8fafc;
}
QListWidget::item, QTreeWidget::item { color: #1f2329; }
QListWidget::item { border-radius: 4px; }
QListWidget::item:hover { background-color: #f1f5fd; }
QListWidget::item:selected,
QTreeWidget::item:selected {
    background-color: #e0ebff;
    color: #1f2329;
}

QHeaderView::section {
    background-color: #f7f8fa;
    color: #5f6672;
    border: none;
    border-right: 1px solid #eceef1;
    border-bottom: 1px solid #e3e5e8;
    padding: 4px 8px;
    font-weight: 600;
}
QTableCornerButton::section {
    background-color: #f7f8fa;
    border: none;
    border-bottom: 1px solid #e3e5e8;
}

/* ---- Checkboxes / radios ---- */
QCheckBox, QRadioButton {
    background-color: transparent;
    color: #1f2329;
    spacing: 6px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #b0b5be;
    background-color: #ffffff;
}
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #2563eb;
}
QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: url(:/gui/check.png);
    image-position: center;
}
QRadioButton::indicator:checked {
    background-color: #2563eb;
    border: 3px solid #ffffff;
    outline: 1px solid #2563eb;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #f0f1f4;
    border-color: #d4d7dc;
}

/* ---- Progress ---- */
QProgressBar {
    background-color: #eef0f3;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #1f2329;
}
QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}

/* ---- Scroll bars ---- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #d0d3d9; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #b0b5be; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #d0d3d9; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #b0b5be; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---- Menus / tooltips ---- */
QMenu {
    background-color: #ffffff;
    color: #1f2329;
    border: 1px solid #d4d7dc;
    border-radius: 6px;
    padding: 3px;
}
QMenu::item {
    background-color: transparent;
    border-radius: 4px;
    padding: 5px 24px 5px 14px;
}
QMenu::item:selected { background-color: #e8f0fe; }
QMenu::separator { height: 1px; background: #eceef1; margin: 4px 8px; }
QToolTip {
    background-color: #2b2d33;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QPlainTextEdit { font-family: Consolas, "Courier New", monospace; }
